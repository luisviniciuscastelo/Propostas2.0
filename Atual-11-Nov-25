            <div class="modal-content">
                <h3 id="category-modal-title" class="text-xl font-bold mb-6 text-center text-cyan-800">Adicionar Nova Categoria</h3>
                <form id="category-form" class="space-y-4">
                    <input type="hidden" id="categoryId-modal">
                    <div>
                        <label for="category-name" class="block text-sm font-medium text-gray-700">Nome da Categoria</label>
                        <input type="text" id="category-name" class="modal-input mt-1" required>
                    </div>
                    <div class="flex justify-end gap-4 pt-4">
