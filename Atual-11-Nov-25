        function calculateAllTotals() {
            const vidas = parseInt(formElements.numVidas.value) || 0;
            let custoMensal = 0;
            let detailedCosts = [];
            const isClientView = !auth.currentUser || auth.currentUser.isAnonymous;

            document.querySelectorAll('.service-row.selected').forEach(el => {
                const { id, category } = el.dataset;
                const services = priceState[category];
                if (!services || !Array.isArray(services)) return;

                const service = services.find(s => s.id === id);
                if (!service) return;

                let price;
                if (isClientView) {
                    price = service.preco ?? getPriceFromState(vidas, service.precos);
                     if (service.isDynamic) {
                        const pgrPrice = getPriceFromState(vidas, priceState.anual.find(s => s.id === 'pgr').precos);
                        const pcmsoPrice = getPriceFromState(vidas, priceState.anual.find(s => s.id === 'pcmso').precos);
                        price = (pgrPrice + pcmsoPrice) * service.multiplier;
                    }
                } else {
                    const priceInput = el.querySelector('.price-input');
                    price = priceInput ? parseCurrency(priceInput.value) : 0;
                }

                let monthlyContribution = 0;

                if (category === 'porVida') {
                    const total = price * vidas;
                    monthlyContribution = total;
                } else if (category === 'anual') {
                    const quantity = parseInt(el.querySelector('.quantity-input')?.value || 1);
                    let totalAnual = price * (service.tipo === 'fixo' ? 1 : quantity);
                    if (id === 'atend_in_company') {
                        const frequency = el.querySelector('.frequency-selector').value;
                        if (frequency === 'mensal') totalAnual = price * quantity * 12;
                        else if (frequency === 'semanal') totalAnual = price * quantity * 52;
                    }
                    monthlyContribution = totalAnual / 12;
                }
                custoMensal += monthlyContribution;
                detailedCosts.push({ name: service.nome, cost: monthlyContribution, id: service.id });
            });

            if (isClientView) {
                ['porVida', 'anual'].forEach(category => {
                    const services = priceState[category] || [];
                    services.forEach(service => {
                        if (service.obrigatorio && service.oculto) {
                            let price = service.preco ?? getPriceFromState(vidas, service.precos);
                            let monthlyContribution = 0;
                            if (category === 'porVida') {
                                monthlyContribution = price * vidas;
                            } else {
                                monthlyContribution = price / 12;
                            }
                            custoMensal += monthlyContribution;
                            detailedCosts.push({ name: service.nome, cost: monthlyContribution, id: service.id });
                        }
                    });
                });
            }

            document.querySelectorAll('#palestras-container .dynamic-row, #outros-container .dynamic-row').forEach(row => {
                const avulsoCost = parseCurrency(row.querySelector('.price-input').value);
                custoMensal += avulsoCost / 12;
                detailedCosts.push({
                    name: row.querySelector('.theme-input').value || 'Serviço Adicional',
                    cost: avulsoCost / 12,
                    id: 'outro'
                });
            });
            if (!isClientView) {
                resumo.detalhado.innerHTML = detailedCosts.map(item => `<div class="flex justify-between"><span>${item.name}</span><span>${formatCurrency(item.cost)}</span></div>`).join('');
            } else {
                resumo.detalhado.innerHTML = '';
            }

            const taxRate = parseCurrency(formElements.tax.value) / 100;
            const profitRate = parseCurrency(formElements.profit.value) / 100;
            const divisor = 1 - (taxRate + profitRate);
            let valorFinalMensal = 0, impostoValor = 0, lucroValor = 0;

            if (divisor > 0) {
                valorFinalMensal = custoMensal / divisor;
                impostoValor = valorFinalMensal * taxRate;
                lucroValor = valorFinalMensal * profitRate;
            }
            resumo.custo.textContent = formatCurrency(custoMensal);
            resumo.imposto.textContent = formatCurrency(impostoValor);
            resumo.lucro.textContent = formatCurrency(lucroValor);
            resumo.totalMensal.textContent = formatCurrency(valorFinalMensal);
            const valorFinalAnual = valorFinalMensal * 12;
            const valorMensalPorVida = vidas > 0 ? valorFinalMensal / vidas : 0;
            resumo.totalAnual.textContent = formatCurrency(valorFinalAnual);
            resumo.mensalPorVida.textContent = formatCurrency(valorMensalPorVida);
            return { valorFinalMensal, valorFinalAnual, valorMensalPorVida };
        }

