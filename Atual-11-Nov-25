        async function saveServiceCategory(categoryData) {
            const newPriceState = JSON.parse(JSON.stringify(priceState));
            const { id, name } = categoryData;

            if (!Array.isArray(newPriceState.serviceCategories)) {
                newPriceState.serviceCategories = [];
            }

            if (id) { // Edição
                const index = newPriceState.serviceCategories.findIndex(c => c.id === id);
                if (index !== -1) {
                    newPriceState.serviceCategories[index].name = name;
                }
            } else { // Adição
                const newId = name.toLowerCase().replace(/\s+/g, '_') + '_' + Date.now();
                newPriceState.serviceCategories.push({ id: newId, name: name });
            }

            try {
                await setDoc(dbRef.config, { priceState: newPriceState }, { merge: true });
                toast.show('Categoria salva com sucesso!');
            } catch (error) {
                console.error("Erro ao salvar categoria:", error);
                toast.show("Falha ao salvar a categoria.");
            } finally {
                categoryModal.hide();
            }
        }

        async function deleteServiceCategory(categoryId) {
            const newPriceState = JSON.parse(JSON.stringify(priceState));

            // Remove a categoria da lista
            newPriceState.serviceCategories = newPriceState.serviceCategories.filter(c => c.id !== categoryId);

            // Remove o categoryId dos serviços associados
            ['porVida', 'anual'].forEach(model => {
                if(newPriceState[model]) {
                    newPriceState[model].forEach(service => {
                        if (service.categoryId === categoryId) {
                            delete service.categoryId;
                        }
                    });
                }
            });

            try {
                await setDoc(dbRef.config, { priceState: newPriceState }, { merge: true });
                toast.show('Categoria excluída com sucesso!');
            } catch (error) {
                console.error("Erro ao excluir categoria:", error);
                toast.show("Falha ao excluir a categoria.");
            }
        }


