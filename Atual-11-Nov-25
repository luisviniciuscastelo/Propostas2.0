<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gerenciamento de Propostas - Medmais</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/html-docx-js/dist/html-docx.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://unpkg.com/imask"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .tab-button {
            transition: all 0.3s ease;
        }

        .tab-button.active {
            border-color: #0891b2;
            background-color: #0891b2;
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .service-card {
            transition: all 0.3s ease;
        }

        .service-card.selected {
            border-color: #0891b2;
            background-color: #ecfeff;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }

        .price-input,
        .quantity-input,
        .theme-input,
        .percent-input,
        .table-price-input,
        .frequency-selector,
        .modal-input {
            text-align: center;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 4px 8px;
            transition: all 0.2s ease;
        }

        .service-card.selected .price-input,
        .service-card.selected .quantity-input,
        .financial-card .percent-input,
        .table-price-input,
        .service-card.selected .frequency-selector,
        .modal-input:focus {
            background-color: #fff;
            border-color: #94a3b8;
        }

        .price-input {
            width: 110px;
            text-align: right;
        }

        .quantity-input {
            width: 70px;
        }

        .theme-input {
            width: 100%;
            text-align: left;
        }

        .percent-input {
            width: 80px;
        }

        .table-price-input {
            width: 100%;
        }

        .frequency-selector {
            text-align: left;
        }

        .prose {
            max-width: 100%;
        }

        .description-textarea {
            width: 100%;
            min-height: 80px;
            padding: 8px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
        }

        /* Estilos para Modal e Notificações */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease-in-out;
        }

        .modal-overlay.visible {
            opacity: 1;
            visibility: visible;
        }

        .modal-content {
            background: white;
            padding: 2rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            transform: scale(0.95);
            transition: all 0.3s ease-in-out;
            width: 90%;
            max-width: 500px;
        }

        .modal-overlay.visible .modal-content {
            transform: scale(1);
        }

        .modal-input,
        .modal-select {
            width: 100%;
            padding: 0.5rem;
            text-align: left;
        }

        .toast-notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #22c55e;
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            z-index: 1001;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.4s ease;
        }

        .toast-notification.show {
            opacity: 1;
            transform: translateY(0);
        }

        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .loader {
            border: 8px solid #f3f3f3;
            border-radius: 50%;
            border-top: 8px solid #0891b2;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @media print {
            body * {
                visibility: hidden;
            }

            .printable-area,
            .printable-area * {
                visibility: visible;
            }

            .printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .no-print {
                display: none;
            }
        }
        .q-btn {
            padding: 8px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            background-color: #f8fafc;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .q-btn.active {
            background-color: #0891b2;
            color: white;
            border-color: #0891b2;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-800">

    <div id="login-modal" class="modal-overlay visible">
