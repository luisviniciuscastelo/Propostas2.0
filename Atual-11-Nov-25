                    let price;
                    if (isClientView) {
                        price = service.preco ?? getPriceFromState(vidas, service.precos);
                        if (service.isDynamic) {
                            const pgrPrice = getPriceFromState(vidas, priceState.anual.find(s => s.id === 'pgr').precos);
                            const pcmsoPrice = getPriceFromState(vidas, priceState.anual.find(s => s.id === 'pcmso').precos);
                            price = (pgrPrice + pcmsoPrice) * service.multiplier;
                        }
                    } else {
                        price = parseCurrency(el.querySelector('.price-input').value);
                    }

                    const quantity = parseInt(el.querySelector('.quantity-input')?.value || 1);
                    const frequency = el.querySelector('.frequency-selector')?.value || 'anual';
                    services[category].push({ ...service, category, price, quantity, frequency });
                }
            });

            services.avulsos.push(...Array.from(document.querySelectorAll('#palestras-container .dynamic-row')).map(row => ({
                id: 'palestra',
                category: 'avulsos',
                nome: 'Palestra Exclusiva',
