            if (!dbRef.logs) return;
            const collectionName = logType === 'price' ? 'priceLog' : 'proposalLog';
            try {
                await addDoc(collection(dbRef.logs, collectionName), { ...entry,
                    timestamp: serverTimestamp()
                });
            } catch (error) {
                console.error("Erro ao adicionar log:", error);
            }
        }

