        async function updatePriceInDB(category, serviceIndex, tierIndex, value) {
            const newPriceState = JSON.parse(JSON.stringify(priceState));
            const services = newPriceState[category];
            if (!Array.isArray(services)) return;

            const service = services[serviceIndex];
            if (!service) return;

            let oldValue;

            if (tierIndex !== undefined) {
                oldValue = service.precos[tierIndex].valor;
                service.precos[tierIndex].valor = value;
                addLogEntry('price', {
                    serviceName: service.nome,
                    tierLabel: TIERS[tierIndex].label,
                    oldValue,
                    newValue: value
                });
            } else {
                oldValue = service.preco;
                service.preco = value;
                addLogEntry('price', {
                    serviceName: service.nome,
                    oldValue,
                    newValue: value
                });
            }

            try {
                await setDoc(dbRef.config, {
                    priceState: newPriceState
                }, {
                    merge: true
                });
            } catch (error) {
                console.error("Erro ao atualizar preço:", error);
                toast.show("Falha ao salvar alteração de preço.");
            }
        }

        async function updateServiceInDB(serviceData) {
            const {
                id,
                originalCategory,
                newCategory,
                name,
                descricao,
                pricingType,
                serviceType,
                categoryId
            } = serviceData;
            const newPriceState = JSON.parse(JSON.stringify(priceState));

            const serviceIndex = newPriceState[originalCategory].findIndex(s => s.id === id);
            if (serviceIndex === -1) {
                toast.show("Erro: Serviço original não encontrado.");
                return;
            }
            const [serviceToUpdate] = newPriceState[originalCategory].splice(serviceIndex, 1);

            serviceToUpdate.nome = name;
            serviceToUpdate.descricao = descricao;
            serviceToUpdate.categoryId = categoryId;

            if (pricingType === 'faixa') {
                if (!serviceToUpdate.precos) {
                    serviceToUpdate.precos = buildTiers(Array(9).fill(0));
                }
                delete serviceToUpdate.preco;
                delete serviceToUpdate.tipo;
            } else {
                if (serviceToUpdate.precos) {
                    serviceToUpdate.preco = 0;
                }
                serviceToUpdate.tipo = serviceType;
                delete serviceToUpdate.precos;
            }

            newPriceState[newCategory].push(serviceToUpdate);

            try {
                await setDoc(dbRef.config, {
                    priceState: newPriceState
                }, {
                    merge: true
                });
                toast.show('Serviço atualizado com sucesso!');
            } catch (error) {
                console.error("Erro ao atualizar serviço:", error);
                toast.show("Falha ao atualizar o serviço.");
            } finally {
                editServiceModal.hide();
            }
        }

