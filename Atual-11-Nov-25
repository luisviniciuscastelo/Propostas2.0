            })));
            services.avulsos.push(...Array.from(document.querySelectorAll('#outros-container .dynamic-row')).map(row => ({
                id: 'outro',
                category: 'avulsos',
                nome: row.querySelector('.theme-input').value || 'Outro Serviço',
                price: parseCurrency(row.querySelector('.price-input').value)
            })));

            return { clientData, services };
        }

