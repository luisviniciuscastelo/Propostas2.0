        async function saveProposal() {
            const proposalData = getFormData();
            if (!proposalData.clientData.clientName) {
                toast.show('Por favor, preencha o nome da empresa.');
                return;
            }

            const clientToSave = {
                id: proposalData.clientData.generatorClientId,
                name: proposalData.clientData.clientName,
                cnpj: proposalData.clientData.clientCnpj,
                address: proposalData.clientData.clientAddress,
                contactPerson: proposalData.clientData.clientContactPerson,
                contactRole: proposalData.clientData.clientContactRole,
                email: proposalData.clientData.clientEmail,
                phone: proposalData.clientData.clientPhone
            };

            const savedClientId = await saveClient(clientToSave, false);

            proposalData.clientData.id = savedClientId;
            const isUpdate = !!proposalData.clientData.proposalId;
            const proposalId = isUpdate ? proposalData.clientData.proposalId : doc(collection(db, 'dummy')).id;

            proposalData.clientData.proposalId = proposalId;
            proposalData.clientData.lastSaved = new Date().toISOString();

            if (!isUpdate) {
                proposalData.status = "Criada";
                proposalData.history = [{
                    status: "Criada",
                    timestamp: new Date().toISOString(),
                    observation: "Proposta gerada no sistema."
                }];
            }

            const proposalRef = doc(dbRef.proposals, proposalId);

            try {
                await setDoc(proposalRef, proposalData, {
                    merge: true
                });
                const action = `Proposta para <strong>${proposalData.clientData.clientName}</strong> ${isUpdate ? 'atualizada' : 'criada'}.`;
                addLogEntry('proposal', {
                    action
                });
                toast.show('Proposta salva com sucesso na nuvem!');
            } catch (error) {
                console.error("Erro ao salvar proposta: ", error);
                toast.show('Erro ao salvar a proposta.');
            }
        }

        function loadProposal(proposalId) {
            const proposal = savedProposals.find(p => p.id === proposalId);
            if (!proposal) return;

            clearForm(false);

            for (const key in proposal.clientData) {
                if (formElements[key]) formElements[key].value = proposal.clientData[key];
            }

            Object.keys(proposal.services).forEach(category => {
                const services = proposal.services[category];
                if (Array.isArray(services)) {
                    services.forEach(s => {
                        if (s.id === 'palestra' || s.id === 'outro') {
                            const containerId = s.id === 'palestra' ? 'palestras-container' : 'outros-container';
                            createDynamicRow(containerId, s.id === 'palestra' ? 'Tema da Palestra' : 'Descrição do Serviço', runAllUpdates, s.price, s.theme);
                        } else {
                            const row = document.querySelector(`.service-row[data-id="${s.id}"]`);
                            if (row) {
                                const checkbox = row.querySelector('.service-checkbox');
                                if (checkbox && !checkbox.checked) {
                                    checkbox.click();
                                }
                                const priceInput = row.querySelector('.price-input');
                                if (priceInput) {
                                    priceInput.value = s.price.toFixed(2).replace('.', ',');
                                }
                                if (row.querySelector('.quantity-input')) row.querySelector('.quantity-input').value = s.quantity;
                                if (row.querySelector('.frequency-selector')) row.querySelector('.frequency-selector').value = s.frequency;
                            }
                        }
                    });
                }
            });

            runAllUpdates();
            addLogEntry('proposal', {
                action: `Proposta para <strong>${proposal.clientData.clientName}</strong> carregada.`
            });
        }

