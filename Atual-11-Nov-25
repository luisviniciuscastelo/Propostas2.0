                cipa: document.getElementById('q-cipa').value,
                machines: document.getElementById('q-machines').value,
                confined: document.getElementById('q-confined').value,
                noise: document.getElementById('q-noise').value,
                heat: document.getElementById('q-heat').value,
                danger: document.getElementById('q-danger').value,
                radioactive: document.getElementById('q-radioactive').value,
                area: document.getElementById('q-area').value,
                other: document.getElementById('q-other').value,
            };

            const clientId = doc(collection(db, 'dummy')).id;
            const proposalId = doc(collection(db, 'dummy')).id;

            proposalData.clientData.id = clientId;
            proposalData.clientData.proposalId = proposalId;
            proposalData.status = "Solicitada pelo Cliente";
            proposalData.questionnaireAnswers = questionnaireAnswers;
            proposalData.history = [{
                status: "Solicitada pelo Cliente",
                timestamp: new Date().toISOString(),
                observation: "Proposta solicitada via formulário online."
            }];

            const clientToSave = {
                id: clientId,
                name: proposalData.clientData.clientName,
                cnpj: proposalData.clientData.clientCnpj,
                address: proposalData.clientData.clientAddress,
                contactPerson: proposalData.clientData.clientContactPerson,
                contactRole: proposalData.clientData.clientContactRole,
                email: proposalData.clientData.clientEmail,
                phone: proposalData.clientData.clientPhone
            };

            const publicProposalRef = doc(db, `publicArtifacts/${appId}/proposals`, proposalId);
            const publicClientRef = doc(db, `publicArtifacts/${appId}/clients`, clientId);

            try {
                const batch = writeBatch(db);
                batch.set(publicClientRef, clientToSave);
                batch.set(publicProposalRef, proposalData);

                await batch.commit();

                thankYouModal.show();

                const btnGenerate = document.getElementById('btn-generate-proposal');
                btnGenerate.disabled = true;
                btnGenerate.textContent = 'Orçamento Solicitado';
                btnGenerate.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                btnGenerate.classList.add('bg-gray-400', 'cursor-not-allowed');


            } catch (error) {
                console.error("Erro ao enviar solicitação: ", error);
                toast.show('Erro ao processar a solicitação.');
            }
        }


        document.getElementById('btn-save-proposal').addEventListener('click', saveProposal);
        document.getElementById('questionnaire-form').addEventListener('submit', (e) => {
            e.preventDefault();
            handleQuestionnaireSubmit();
        });
        document.querySelectorAll('.q-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const group = btn.dataset.group;
                document.querySelectorAll(`.q-btn[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById(`q-${group}`).value = btn.textContent;
            });
        });
        document.getElementById('btn-new-proposal').addEventListener('click', () => clearForm(true));
        document.getElementById('add-palestra').addEventListener('click', () => {
            const vidas = parseInt(formElements.numVidas.value) || 0;
            const price = getPriceFromState(vidas, priceState.palestra.precos);
            createDynamicRow('palestras-container', 'Tema da Palestra', runAllUpdates, price);
        });
        document.getElementById('add-outro').addEventListener('click', () => createDynamicRow('outros-container', 'Descrição do Serviço', runAllUpdates));
        document.getElementById('export-word-btn').addEventListener('click', exportProposalToWord);
        document.getElementById('export-pdf-btn').addEventListener('click', exportProposalToPdf);

        document.querySelectorAll('.tab-button').forEach(button => {
            button.addEventListener('click', () => {
                document.querySelectorAll('.tab-button, .tab-content').forEach(el => el.classList.remove('active'));
                button.classList.add('active');
                document.getElementById(`tab-${button.dataset.tab}`).classList.add('active');
            });
        });

        document.addEventListener('input', (e) => {
            if (e.target.closest('#tab-generator')) {
                if (e.target.id === 'numVidas') {
                    updateSuggestedValues();
                }
                runAllUpdates();
            }
        });

        const questionnaireAnswersModal = {
            overlay: document.getElementById('questionnaire-answers-modal'),
            content: document.getElementById('questionnaire-answers-content'),
            closeBtn: document.getElementById('modal-answers-close-btn'),
            show: () => questionnaireAnswersModal.overlay.classList.add('visible'),
            hide: () => questionnaireAnswersModal.overlay.classList.remove('visible')
        };
        questionnaireAnswersModal.closeBtn.addEventListener('click', questionnaireAnswersModal.hide);

        const thankYouModal = {
            overlay: document.getElementById('thank-you-modal'),
            closeBtn: document.getElementById('modal-thank-you-close-btn'),
            show: () => thankYouModal.overlay.classList.add('visible'),
            hide: () => thankYouModal.overlay.classList.remove('visible')
        };
        thankYouModal.closeBtn.addEventListener('click', thankYouModal.hide);

        savedProposalsContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('load-proposal-btn')) {
                document.querySelector('.tab-button[data-tab="generator"]').click();
                loadProposal(e.target.dataset.id);
            }
            if (e.target.classList.contains('delete-proposal-btn')) {
                deleteProposal(e.target.dataset.id);
            }
             if (e.target.classList.contains('view-answers-btn')) {
                const proposal = savedProposals.find(p => p.id === e.target.dataset.id);
                if (proposal && proposal.questionnaireAnswers) {
                    const answers = proposal.questionnaireAnswers;
                    const contentHtml = `
                        <div class="p-2 bg-gray-100 rounded"><strong>1) Atividades da empresa:</strong><p class="pl-2">${answers.activities || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>2) Quantas sedes:</strong><p class="pl-2">${answers.locations || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>3) Documentos existentes:</strong><p class="pl-2">${answers.documents.join(', ') || 'Nenhum'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>4) Possui CIPA:</strong><p class="pl-2">${answers.cipa || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>5) Atividades com máquinas:</strong><p class="pl-2">${answers.machines || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>6) Trabalho em altura/espaço confinado:</strong><p class="pl-2">${answers.confined || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>7) Exposição a ruído:</strong><p class="pl-2">${answers.noise || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>8) Exposição ao calor:</strong><p class="pl-2">${answers.heat || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>9) Atividades perigosas (eletricidade, etc.):</strong><p class="pl-2">${answers.danger || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>10) Manuseio de material radioativo:</strong><p class="pl-2">${answers.radioactive || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>11) Área construída (+750m² ou 2+ pavimentos):</strong><p class="pl-2">${answers.area || 'Não preenchido'}</p></div>
                        <div class="p-2 bg-gray-100 rounded"><strong>12) Outras informações:</strong><p class="pl-2">${answers.other || 'Nenhuma'}</p></div>
                    `;
                    questionnaireAnswersModal.content.innerHTML = contentHtml;
                    questionnaireAnswersModal.show();
                } else {
                    toast.show("Respostas do questionário não encontradas para esta proposta.");
                }
            }

            const proposalId = e.target.dataset.id;
            const proposal = savedProposals.find(p => p.id === proposalId);

            if (proposal && proposal.isNew) {
                 const proposalRef = doc(db, `publicArtifacts/${appId}/proposals`, proposalId);
                 updateDoc(proposalRef, { viewedByVendor: true }).catch(err => console.error("Erro ao marcar proposta como visualizada:", err));
            }

            if (e.target.classList.contains('details-proposal-btn')) {
                if (proposal) {
                    proposalDetailsModal.proposalIdInput.value = proposal.id;
                    proposalDetailsModal.statusSelect.value = proposal.status || 'Criada';
                    proposalDetailsModal.observationsInput.value = '';

                    const historyHtml = (proposal.history || []).sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp)).map(h => ` 
                        <div class="p-2 bg-gray-100 rounded"> 
                            <p class="font-semibold">${h.status} - <span class="font-normal text-gray-600">${new Date(h.timestamp).toLocaleString('pt-BR')}</span></p> 
                            <p class="text-gray-800 italic">"${h.observation}"</p> 
                        </div> 
                    `).join('');
                    proposalDetailsModal.historyContainer.innerHTML = historyHtml;

                    proposalDetailsModal.show();
                }
            }
        });

        // Listeners da Aba de Clientes 
        document.getElementById('add-client-btn').addEventListener('click', () => clientModal.show());
        document.getElementById('generator-add-client-btn').addEventListener('click', () => clientModal.show());
        clientModal.cancelBtn.addEventListener('click', () => clientModal.hide());
        clientModal.form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const clientData = {
                id: clientModal.idInput.value,
                name: clientModal.nameInput.value,
                cnpj: clientModal.cnpjInput.value,
                address: clientModal.addressInput.value,
                contactPerson: clientModal.contactPersonInput.value,
                contactRole: clientModal.contactRoleInput.value,
                phone: clientModal.phoneInput.value,
                email: clientModal.emailInput.value,
                type: clientModal.typeInput.value,
                cnae: clientModal.cnaeInput.value,
            };
            await saveClient(clientData);
            clientModal.hide();
        });
        document.getElementById('client-search-input').addEventListener('input', (e) => {
            renderClientsList(e.target.value);
        });

        // --- Integração Gerador <-> Clientes --- 
        const clientNameInput = document.getElementById('clientName');
        const clientSearchResults = document.getElementById('client-search-results');

        const handleClientSearch = () => {
             // Limpa os campos de contato ao digitar um novo nome
            formElements.clientContactPerson.value = '';
            formElements.clientContactRole.value = '';
            formElements.clientEmail.value = '';
            formElements.clientPhone.value = '';

            const searchTerm = clientNameInput.value.toLowerCase();
            if (searchTerm.length < 2) {
                clientSearchResults.innerHTML = '';
                clientSearchResults.classList.add('hidden');
                return;
            }

            const filteredClients = clients.filter(c => c.name.toLowerCase().includes(searchTerm));

            if (filteredClients.length > 0) {
                clientSearchResults.innerHTML = filteredClients.map(c =>
                    `<div class="p-2 hover:bg-gray-100 cursor-pointer" data-id="${c.id}">${c.name}</div>`
                ).join('');
                clientSearchResults.classList.remove('hidden');
            } else {
                clientSearchResults.classList.add('hidden');
            }
        };

        clientNameInput.addEventListener('input', handleClientSearch);

        clientSearchResults.addEventListener('click', (e) => {
            if (e.target.dataset.id) {
                const clientId = e.target.dataset.id;
                const client = clients.find(c => c.id === clientId);
                if (client) {
                    formElements.generatorClientId.value = client.id;
                    formElements.clientName.value = client.name || '';
                    formElements.clientCnpj.value = client.cnpj || '';
                    formElements.clientAddress.value = client.address || '';
                    formElements.clientContactPerson.value = client.contactPerson || '';
                    formElements.clientContactRole.value = client.contactRole || '';
                    formElements.clientEmail.value = client.email || ''; 
                    formElements.clientPhone.value = client.phone || ''; 
                }
                clientSearchResults.innerHTML = '';
                clientSearchResults.classList.add('hidden');
            }
        });

        document.getElementById('service-search-input').addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();

            document.querySelectorAll('.service-card').forEach(card => {
                const serviceName = card.querySelector('h4').textContent.toLowerCase();
                const matches = serviceName.includes(searchTerm);
                card.style.display = matches ? '' : 'none';
            });

            // Oculta os títulos das categorias se todos os serviços estiverem ocultos
            document.querySelectorAll('#servicos-por-vida > div, #servicos-anuais > div').forEach(categoryWrapper => {
                const services = categoryWrapper.querySelectorAll('.service-card');
                const allHidden = Array.from(services).every(s => s.style.display === 'none');
                categoryWrapper.style.display = allHidden ? 'none' : '';
            });
        });

        document.body.addEventListener('click', (e) => {
            if (!clientNameInput.contains(e.target)) {
                clientSearchResults.classList.add('hidden');
            }
        });

        // --- LÓGICA DO MODAL DE REAJUSTE DE PREÇOS --- 
        const openAdjustmentModalBtn = document.getElementById('open-adjustment-modal-btn');

        openAdjustmentModalBtn.addEventListener('click', () => {
            const form = priceAdjustmentModal.form;
            form.innerHTML = '';

            Object.keys(priceState).forEach(category => {
                const services = priceState[category];
                if (Array.isArray(services)) {
                    services.forEach(service => {
                        if (service.precos !== undefined || service.preco !== undefined) {
                            const div = document.createElement('div');
                            div.innerHTML = ` 
                                <label class="flex items-center p-2 rounded-md hover:bg-gray-100"> 
                                    <input type="checkbox" class="service-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded" data-category="${category}" data-id="${service.id}"> 
                                    <span class="ml-3 text-gray-800">${service.nome}</span> 
                                </label> 
                            `;
                            form.appendChild(div);
                        }
                    });
                }
            });

            priceAdjustmentModal.show();
        });

        priceAdjustmentModal.selectAllCheckbox.addEventListener('change', (e) => {
            const isChecked = e.target.checked;
            priceAdjustmentModal.form.querySelectorAll('.service-checkbox').forEach(checkbox => {
                checkbox.checked = isChecked;
            });
        });

        priceAdjustmentModal.cancelBtn.addEventListener('click', priceAdjustmentModal.hide);
        priceAdjustmentModal.applyBtn.addEventListener('click', async () => {
            const adjustmentPercent = parseFloat(document.getElementById('adjustment-percent').value);
            if (isNaN(adjustmentPercent) || adjustmentPercent === 0) {
                toast.show('Por favor, insira uma porcentagem de reajuste válida.');
                return;
            }

            const multiplier = 1 + (adjustmentPercent / 100);
            const newPriceState = JSON.parse(JSON.stringify(priceState));
            let changesMade = false;

            priceAdjustmentModal.form.querySelectorAll('.service-checkbox:checked').forEach(checkbox => {
                const {
                    category,
                    id
                } = checkbox.dataset;
                const service = newPriceState[category].find(s => s.id === id);
                if (!service) return;

                if (service.precos) {
                    service.precos.forEach(tier => tier.valor = parseFloat((tier.valor * multiplier).toFixed(2)));
                } else if (service.preco !== undefined) {
                    service.preco = parseFloat((service.preco * multiplier).toFixed(2));
                }
                changesMade = true;
            });

            if (!changesMade) {
                toast.show("Nenhum serviço selecionado para reajuste.");
                return;
            }

            try {
                await setDoc(dbRef.config, {
                    priceState: newPriceState
                }, {
                    merge: true
                });
                addLogEntry('price', {
                    action: `Reajuste em massa de <strong>${adjustmentPercent}%</strong> aplicado.`,
                    user: userId,
                    value: adjustmentPercent
                });
                toast.show('Preços reajustados com sucesso!');
            } catch (error) {
                console.error("Erro ao aplicar reajuste de preços:", error);
                toast.show("Falha ao reajustar os preços.");
            } finally {
                priceAdjustmentModal.hide();
            }
        });

        // --- LÓGICA DO MODAL DE ACOMPANHAMENTO --- 
        proposalDetailsModal.cancelBtn.addEventListener('click', proposalDetailsModal.hide);
        proposalDetailsModal.form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const proposalId = proposalDetailsModal.proposalIdInput.value;
            const newStatus = proposalDetailsModal.statusSelect.value;
            const newObservation = proposalDetailsModal.observationsInput.value;

            if (!proposalId) return;

            const proposalRef = doc(dbRef.proposals, proposalId);

            const newHistoryEntry = {
                status: newStatus,
                observation: newObservation || 'Status atualizado.',
                timestamp: new Date().toISOString()
            };

            try {
                await updateDoc(proposalRef, {
                    status: newStatus,
                    history: arrayUnion(newHistoryEntry)
                });
                toast.show("Status da proposta atualizado!");
                proposalDetailsModal.hide();
            } catch (error) {
                console.error("Erro ao atualizar status da proposta:", error);
                toast.show("Falha ao atualizar o status.");
            }
        });
    });
    </script>
</body>

</html>
